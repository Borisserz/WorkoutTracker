    "Squeeze triceps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie den Trizeps"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apretar tríceps"
          }
