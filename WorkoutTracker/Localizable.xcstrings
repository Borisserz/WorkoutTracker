    "You don't have enough fully recovered muscles. Take a rest day or do light cardio!": {
      "comment": "Error message displayed when the user doesn't have enough fully recovered muscles to generate a new workout.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben nicht genügend vollständig erholte Muskeln. Machen Sie einen Ruhetag oder machen Sie leichtes Cardio!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes suficientes músculos completamente recuperados. ¡Tómate un día de descanso o haz cardio ligero!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez pas assez de muscles complètement récupérés. Prenez une journée de repos ou faites du cardio léger !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai abbastanza muscoli completamente recuperati. Prenditi un giorno di riposo o fai cardio leggero!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem músculos totalmente recuperados o suficiente. Tire um dia de descanso ou faça exercícios aeróbicos leves!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас недостаточно полностью восстановленных мышц. Возьмите день отдыха или сделайте легкое кардио!"
          }
        }
      }
    },
    "You have been successfully signed out. You are now using a guest account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurden erfolgreich abgemeldet. Sie verwenden jetzt ein Gastkonto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
