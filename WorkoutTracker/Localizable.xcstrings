    "Keep your chest up and gaze forward to maintain proper posture": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihre Brust hoch und blicken Sie nach vorne, um die richtige Haltung beizubehalten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga el pecho erguido y mire hacia adelante para mantener una postura adecuada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre poitrine relevée et regardez vers l’avant pour maintenir une bonne posture"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il petto in alto e guarda avanti per mantenere una postura corretta"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o peito erguido e olhe para frente para manter a postura adequada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите грудь поднятой и смотрите вперед, чтобы поддерживать правильную осанку"
          }
        }
      }
    },
    "Keep your core engaged throughout the exercise": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihren Rumpf während der gesamten Übung in Bewegung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga su núcleo comprometido durante todo el ejercicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre cœur engagé tout au long de l’exercice"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il core impegnato durante l'esercizio"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha seu núcleo engajado durante todo o exercício"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите корпус напряженным на протяжении всего упражнения"
          }
        }
      }
    },
    "Keep your feet firmly planted on the floor for stability": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihre Füße fest auf dem Boden, um Stabilität zu gewährleisten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga los pies firmemente plantados en el suelo para mayor estabilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos pieds fermement plantés sur le sol pour plus de stabilité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni i piedi ben piantati sul pavimento per stabilità"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os pés firmemente plantados no chão para estabilidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите ноги плотно прижатыми к полу для устойчивости"
          }
        }
      }
    },
    "Keep your knees in line with your toes, never let them cave inward": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihre Knie in einer Linie mit Ihren Zehen und lassen Sie sie niemals nach innen einknicken"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga las rodillas alineadas con los dedos de los pies, nunca deje que se doblen hacia adentro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos genoux alignés avec vos orteils, ne les laissez jamais s'effondrer vers l'intérieur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni le ginocchia in linea con le dita dei piedi, non lasciare mai che cedano verso l'interno"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os joelhos alinhados com os dedos dos pés, nunca os deixe ceder para dentro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите колени в одной линии с носками, чтобы они не заваливались внутрь"
          }
        }
      }
    },
    "Keep your shoulder blades retracted and pressed into the bench": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihre Schulterblätter zurückgezogen und in die Bank gedrückt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga los omóplatos retraídos y presionados contra el banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez vos omoplates rétractées et appuyées contre le banc"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni le scapole retratte e premute sulla panca"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha as omoplatas retraídas e pressionadas no banco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите лопатки сведенными и прижатыми к скамье"
          }
        }
      }
    },
