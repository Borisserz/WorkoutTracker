      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Übung wurde noch in keinem Training durchgeführt. Fügen Sie es zu einem Training hinzu, um Ihren Fortschritt zu verfolgen!"
          }
        },
        "es": {
          "stringUnit": {
