          "stringUnit": {
            "state": "translated",
            "value": "Bitte! Я твой ИИ-TRENNER. Sobald Sie das Programm erstellt, die Installation geplant oder die Technik erweitert haben. Чем займемся сегодня?"
          }
        },
        "es": {
          "stringUnit": {
