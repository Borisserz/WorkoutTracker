    "Don't let your %lld-day streak die! 15 minutes is all it takes!": {
      "comment": "A title and body for a push notification that encourages a user to maintain their streak. The argument is the number of days in the streak.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass deine %ll-Tage-Serie nicht sterben! 15 Minuten genügen!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡No dejes que se acabe tu racha de %lld días! ¡15 minutos es todo lo que necesitas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne laissez pas votre séquence de %lld jours s'éteindre ! 15 minutes suffisent !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non lasciare che la tua serie di %lld giorni si esaurisca! 15 minuti sono tutto ciò che serve!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deixe sua sequência de %lld dias morrer! 15 minutos é o suficiente!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не дай умереть своей %lld-дневной серии! 15 минут - и порядок!"
          }
        }
      }
    },
