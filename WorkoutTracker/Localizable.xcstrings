    },
    "Your data is securely stored. Have a good workout, bro.": {
      "comment": "A description of the benefits of using the app.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Daten werden sicher gespeichert. Hab ein gutes Training, Bruder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos se almacenan de forma segura. Que tengas un buen entrenamiento, hermano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont stockées en toute sécurité. Bon entraînement, mon frère."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati sono archiviati in modo sicuro. Buon allenamento, fratello."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados são armazenados com segurança. Tenha um bom treino, mano."
          }
