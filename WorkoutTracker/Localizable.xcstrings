    "Hi! I'm your AI coach. I can help you create a program, analyze fatigue, or improve your technique. What should we do today?": {
      "comment": "A greeting message from the AI chatbot.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo! Ich bin Ihr KI-Coach. Ich kann Ihnen helfen, ein Programm zu erstellen, Müdigkeit zu analysieren oder Ihre Technik zu verbessern. Was sollen wir heute tun?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Hola! Soy tu entrenador de IA. Puedo ayudarte a crear un programa, analizar la fatiga o mejorar tu técnica. ¿Qué debemos hacer hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut! Je suis votre coach en IA. Je peux vous aider à créer un programme, analyser la fatigue ou améliorer votre technique. Que devrions-nous faire aujourd’hui ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "CIAO! Sono il tuo allenatore di intelligenza artificiale. Posso aiutarti a creare un programma, analizzare la fatica o migliorare la tua tecnica. Cosa dovremmo fare oggi?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Oi! Sou seu treinador de IA. Posso ajudá-lo a criar um programa, analisar o cansaço ou melhorar sua técnica. O que devemos fazer hoje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привет! Я твой AI тренер. Чем займемся сегодня?"
          }
        }
      }
    },
