    "Your body is a reflection of your discipline. Keep pushing your limits — no excuses.": {
      "comment": "A description of the benefits of staying active.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Körper ist ein Spiegelbild Ihrer Disziplin. Gehen Sie weiter an Ihre Grenzen – keine Ausreden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuerpo es un reflejo de tu disciplina. Sigue superando tus límites, sin excusas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre corps est le reflet de votre discipline. Continuez à repousser vos limites – pas d’excuses."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo corpo è un riflesso della tua disciplina. Continua a superare i tuoi limiti, senza scuse."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu corpo é um reflexo de sua disciplina. Continue ultrapassando seus limites – sem desculpas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твое тело — отражение дисциплины. Без отговорок."
          }
        }
      }
    },
    "Your body is ready for the next challenge. Let's go!": {
