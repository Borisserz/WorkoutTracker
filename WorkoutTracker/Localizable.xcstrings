    "I agree to the Terms of Use and Community Guidelines, and I understand that objectionable content is not tolerated.": {
      "comment": "Label for a toggle that requires the user to agree to the app's EULA and community guidelines before sharing content.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich stimme den Nutzungsbedingungen und Community-Richtlinien zu und verstehe, dass anstößige Inhalte nicht toleriert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto los Términos de uso y las Pautas de la comunidad, y entiendo que no se tolera contenido objetable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J'accepte les conditions d'utilisation et les directives de la communauté et je comprends que les contenus répréhensibles ne sont pas tolérés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetto i Termini di utilizzo e le Linee guida della community e capisco che i contenuti discutibili non sono tollerati."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Concordo com os Termos de Uso e as Diretrizes da Comunidade e entendo que conteúdo questionável não é tolerado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я согласен с условиями использования."
          }
        }
      }
    },
    "I believe you can hit a new %@ PR of %@%@ today!": {
      "comment": "Text for a friendly \"PR Predicted.\" notification. The first argument is the exercise name. The second argument is the weight lifted.",
