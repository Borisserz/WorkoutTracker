    "Would you like a quick interactive tour to learn how to create workouts and track progress?": {
      "comment": "A text displayed below the main title, asking the user if they want a quick tutorial.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie an einer kurzen interaktiven Tour teilnehmen, um zu erfahren, wie Sie Workouts erstellen und Fortschritte verfolgen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Le gustaría un recorrido interactivo rápido para aprender a crear entrenamientos y realizar un seguimiento del progreso?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhaitez-vous une visite interactive rapide pour apprendre à créer des entraînements et suivre les progrès ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Desideri un breve tour interattivo per imparare a creare allenamenti e monitorare i progressi?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Gostaria de um rápido tour interativo para aprender como criar treinos e acompanhar o progresso?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите быстрый интерактивный тур, чтобы узнать, как создавать тренировки и отслеживать прогресс?"
          }
        }
      }
    },
