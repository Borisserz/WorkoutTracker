    "Keep crushing it!\nYou're on fire! 🔥": {
      "comment": "Speech bubble text in the \"Streak Mascot Popup\" view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zerstöre es weiter!\nDu brennst! 🔥"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Sigue aplastándolo!\n¡Estás en llamas! 🔥"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez à l'écraser !\nTu es en feu ! 🔥"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a schiacciarlo!\nSei in fiamme! 🔥"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue esmagando!\nVocê está pegando fogo! 🔥"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжай рвать!\nТы в огне! 🔥"
          }
        }
      }
    },
    "Keep the bar close to your body - it should almost scrape your shins": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Stange nah am Körper – sie sollte fast Ihre Schienbeine berühren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la barra cerca de su cuerpo; casi debería rasparle las espinillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la barre près de votre corps - elle devrait presque vous gratter les tibias"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni la barra vicino al corpo: dovrebbe quasi graffiarti gli stinchi"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a barra próxima ao corpo – ela quase deve arranhar suas canelas"
