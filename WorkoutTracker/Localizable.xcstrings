    "Register an account to securely save your progress, sync across devices, and share workouts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrieren Sie ein Konto, um Ihre Fortschritte sicher zu speichern, geräteübergreifend zu synchronisieren und Trainingseinheiten zu teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre una cuenta para guardar de forma segura su progreso, sincronizarlo entre dispositivos y compartir entrenamientos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un compte pour enregistrer en toute sécurité vos progrès, synchroniser sur tous les appareils et partager des entraînements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un account per salvare in modo sicuro i tuoi progressi, sincronizzarti su più dispositivi e condividere gli allenamenti."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
