          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идеально! Покажи ✌️ для захвата."
          }
        }
      }
    },
    "Perform this exercise with proper form, focusing on controlled movements and full range of motion. Engage your core throughout the exercise and avoid using momentum. Consult with a fitness professional for specific technique guidance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie diese Übung mit der richtigen Form durch und konzentrieren Sie sich auf kontrollierte Bewegungen und den vollen Bewegungsumfang. Beanspruchen Sie während der gesamten Übung Ihren Rumpf und vermeiden Sie Schwung. Wenden Sie sich an einen Fitnessprofi, um eine spezifische Technikanleitung zu erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realice este ejercicio con la forma adecuada, concentrándose en movimientos controlados y rango completo de movimiento. Involucre su núcleo durante todo el ejercicio y evite usar el impulso. Consulte con un profesional del fitness para obtener orientación técnica específica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuez cet exercice avec une forme appropriée, en vous concentrant sur des mouvements contrôlés et une amplitude complète de mouvement. Engagez votre cœur tout au long de l’exercice et évitez d’utiliser votre élan. Consultez un professionnel du fitness pour obtenir des conseils techniques spécifiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui questo esercizio con la forma corretta, concentrandoti su movimenti controllati e su una gamma completa di movimento. Coinvolgi il tuo core durante l'esercizio ed evita di usare lo slancio. Consultare un professionista del fitness per indicazioni tecniche specifiche."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute este exercício de forma adequada, concentrando-se em movimentos controlados e amplitude total de movimento. Envolva seu núcleo durante todo o exercício e evite usar impulso. Consulte um profissional de fitness para orientação técnica específica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тыполняйте это упражнение с правильной формой, сосредоточьтесь на контролируемых движениях и полной амплитуде. Напрягайте корпус на протяжении всего упражнения и избегайте использования инерции. Обратитесь к фитнес-профессионалу за конкретными рекомендациями по технике."
          }
        }
      }
    },
    "Performance decreased by %lld%%.": {
      "comment": "A recommendation to review an exercise that is showing signs of decline in performance. The argument is the name of the exercise.",
