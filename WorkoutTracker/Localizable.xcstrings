    "Perfect! Show ✌️ to capture.": {
      "comment": "A dynamic hint that appears when the user's body is correctly aligned in the Smart Capture view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
