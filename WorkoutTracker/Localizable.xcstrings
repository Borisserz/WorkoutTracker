    "It's been %lld days! A quick 20-min session is better than nothing.": {
      "comment": "Text displayed in a notification when a user is inactive for a certain number of days. The argument is the number of days the user has been inactive.",
      "extractionState": "stale",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
