    "Permanently deletes your account and all associated data from our servers, including shared workouts, your blocked list, and submitted reports. This cannot be undone.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht Ihr Konto und alle zugehörigen Daten dauerhaft von unseren Servern, einschließlich freigegebener Trainingseinheiten, Ihrer Sperrliste und übermittelten Berichte. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina permanentemente su cuenta y todos los datos asociados de nuestros servidores, incluidos los entrenamientos compartidos, su lista de bloqueados y los informes enviados. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement votre compte et toutes les données associées de nos serveurs, y compris les entraînements partagés, votre liste bloquée et les rapports soumis. Cela ne peut pas être annulé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente il tuo account e tutti i dati associati dai nostri server, inclusi gli allenamenti condivisi, l'elenco bloccato e i report inviati. Questa operazione non può essere annullata."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui permanentemente sua conta e todos os dados associados de nossos servidores, incluindo treinos compartilhados, sua lista de bloqueados e relatórios enviados. Isto não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет аккаунт и все данные."
          }
        }
      }
    },
