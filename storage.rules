rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read-only access for localized and base exercise catalog JSON files.
    match /{fileName} {
      allow read: if fileName.matches('^exercises(_[a-zA-Z0-9_-]+)?\\.json$');
      allow write: if false;
    }

    // Preserved live rule for Autora ecosystem app sharing this Storage bucket.
    match /autora/{uid}/listings/{listingId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny all other Storage paths and sub-paths.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
